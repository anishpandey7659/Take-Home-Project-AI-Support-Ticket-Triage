# Groq API keys
# Two keys are used by separate workers to distribute API usage.
GROQ_API_KEY="API_KEY_1"
GROQ_API_KEY2="API_KEY_2"

# Primary and fallback models for Worker 1
GROQ_MODEL="openai/gpt-oss-120b"
FALLBACK_MODEL1="qwen/qwen3.8-27b"

# Primary and fallback models for Worker 2
GROQ_MODEL2="openai/gpt-oss-120b"
FALLBACK_MODEL2="qwen/qwen3.8-27b"

# LLM generation settings
DEFAULT_TEMPERATURE=0.1

# Maximum number of concurrent requests
MAX_CONCURRENCY=5